+          reserveShortMWh:x.reserveShortMWh, socLi:sl(x.socByTier&&x.socByTier.li), socFe:sl(x.socByTier&&x.socByTier.fe), disLi:sl(x.battByTier&&x.battByTier.li), disFe:sl(x.battByTier&&x.battByTier.fe),
+          chargeBatt:sl(x.chargeBattMW), chargePs:sl(x.chargePsMW), battTierTWh:x.battTierTWh,
