+    const r=JSON.parse(w.eval(`(function(){ const o=[]; for (const yy of bldWeatherYears.meta.years) for (let k=0;k<${K};k++){ const nat=weatherYearNational(String(yy));
+      const st={...state,...${JSON.stringify(over)},outageSeed:${SEED_BASE}+k*104729+yy*7919};
+      const x=simulate(st,{demand:PROFILES.demand,solar:nat.solar,wind:nat.wind,csp:PROFILES.csp,real:true});
+      const u=x.stack.unserved; let s=0,best=-1,bh=0; for(let h=0;h<u.length;h++){ s+=u[h]||0; if(h>=168) s-=u[h-168]||0; if(h>=167 && s>best){best=s; bh=h-167;} }
+      o.push({y:${y}, wy:yy, k, seed:${SEED_BASE}+k*104729+yy*7919, shedGWh:x.E.unserved/1e3, worst168GWh:best/1e3, worstStart:bh}); }
+      return JSON.stringify(o); })()`));
