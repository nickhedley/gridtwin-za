+      const res=JSON.parse(w.eval(`(function(){ const nat=${WY==='default'?'{solar:PROFILES.solar,wind:PROFILES.wind}':'weatherYearNational(String('+(+WY)+'))'}; const st={...state,...${JSON.stringify(over)},outageSeed:${sd}};
